# Copiez ce fichier en .env pour le développement local.
DJANGO_SETTINGS_MODULE=config.settings.dev

# Obligatoire en production (générer une clé longue et aléatoire).
SECRET_KEY=dev-insecure-key-change-me

DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Laissez vide en local pour utiliser SQLite, ou renseignez l'URL Neon :
# DATABASE_URL=postgres://USER:PASSWORD@HOST/DBNAME?sslmode=require
DATABASE_URL=

# Origines de confiance CSRF en production (séparées par des virgules) :
CSRF_TRUSTED_ORIGINS=

TIME_ZONE=Europe/Paris

# Production uniquement :
# SECURE_SSL_REDIRECT=True
# SECURE_HSTS_SECONDS=2592000
# EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
# LOG_LEVEL=INFO
