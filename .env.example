# Copiez ce fichier en .env pour le développement local.
DJANGO_SETTINGS_MODULE=config.settings.dev

# Obligatoire en production (générer une clé longue et aléatoire).
SECRET_KEY=dev-insecure-key-change-me

DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Laissez vide en local pour utiliser SQLite, ou renseignez l'URL Neon :
# DATABASE_URL=postgres://USER:PASSWORD@HOST/DBNAME?sslmode=require
DATABASE_URL=

# Origines de confiance CSRF en production (séparées par des virgules) :
CSRF_TRUSTED_ORIGINS=

TIME_ZONE=Africa/Dakar

# Envoi réel des identifiants joueur par e-mail (facultatif — sans EMAIL_HOST,
# les e-mails restent seulement journalisés en console). Exemple avec Gmail
# (utiliser un mot de passe d'application, jamais le mot de passe du compte) :
# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=587
# EMAIL_USE_TLS=True
# EMAIL_HOST_USER=votre-compte@gmail.com
# EMAIL_HOST_PASSWORD=mot-de-passe-application
# DEFAULT_FROM_EMAIL=Championnat de Scrabble <votre-compte@gmail.com>

# Production uniquement :
# SECURE_SSL_REDIRECT=True
# SECURE_HSTS_SECONDS=2592000
# EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
# LOG_LEVEL=INFO
